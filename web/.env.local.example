# ─────────────────────────────────────────────────────────────
#  Asistente de IA de Sintraeducación
# ─────────────────────────────────────────────────────────────
#  1. Copie este archivo con el nombre  .env.local  (en esta misma carpeta "web").
#  2. Pegue su clave de OpenAI después del signo igual, sin comillas ni espacios.
#  3. En la app: Más → Configuración → Asistente de IA → "Probar conexión".
#
#  No hace falta reiniciar la app: la clave se lee en cada consulta.
#  El archivo .env.local nunca se sube al repositorio y la clave nunca llega al navegador.
#  Recomendado: ponga un límite de gasto en https://platform.openai.com (Billing → Limits).

OPENAI_API_KEY=

# Opcional: forzar un modelo. Si se deja vacío, la app elige el modelo "mini" más
# reciente disponible para su clave (económico y con herramientas).
OPENAI_MODEL=

# ─────────────────────────────────────────────────────────────
#  Acceso para un tester por túnel (cloudflared)
# ─────────────────────────────────────────────────────────────
#  Quien entre desde afuera debe escribir usuario "tester" y esta clave.
#  Si se deja vacía, el acceso externo queda cerrado. En localhost no se pide.
ACCESO_CLAVE=

{
  "name": "sintraeducacion-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.servidor.json && vite build",
    "preview": "vite preview",
    "desplegar": "npm run build && wrangler pages deploy dist --project-name sintraeducacion --branch main",
